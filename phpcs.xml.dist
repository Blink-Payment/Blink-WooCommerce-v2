<?xml version="1.0"?>
<ruleset name="Blink Payment Gateway for WooCommerce">
	<description>WordPress Coding Standards for the WordPress.org plugin review.</description>

	<file>.</file>

	<!-- Not shipped in the plugin zip, or not ours. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/.agents/*</exclude-pattern>
	<exclude-pattern>/.claude/*</exclude-pattern>
	<exclude-pattern>/.codex/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<rule ref="PHPCompatibilityWP"/>
	<!-- Keep in step with "Requires PHP" in readme.txt. -->
	<config name="testVersion" value="7.4-"/>

	<!-- Keep in step with "Requires at least" in readme.txt and the plugin header. -->
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="blink-payment-gateway-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Registered by WooCommerce. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="pay_for_order"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="blink_pg"/>
			</property>
		</properties>
	</rule>
</ruleset>
